<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. 视频预览层 -->
    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. 预览关闭时的中心状态：仅显示 RTSP 地址 + 客户端 IP -->
    <LinearLayout
        android:id="@+id/layoutCenterStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvCenterUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvCenterClient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF4444"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvStreamDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#66FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- 3. 顶部单行工具栏：左侧参数 | 中间RTSP地址(可点击复制) | 右侧按钮 -->
    <LinearLayout
        android:id="@+id/layoutTopControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#44000000"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ====== 左侧：分辨率 / 码率 / 帧率 / 关键帧 ====== -->
        <TextView
            android:id="@+id/tvResolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="1920x1080"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <View android:layout_width="1dp" android:layout_height="10dp"
            android:background="#33FFFFFF" android:layout_marginHorizontal="3dp" />

        <TextView
            android:id="@+id/tvBitrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="10 Mbps"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <View android:layout_width="1dp" android:layout_height="10dp"
            android:background="#33FFFFFF" android:layout_marginHorizontal="3dp" />

        <TextView
            android:id="@+id/tvFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="30 FPS"
            android:textColor="#FFD700"
            android:textSize="11sp" />

        <View android:layout_width="1dp" android:layout_height="10dp"
            android:background="#33FFFFFF" android:layout_marginHorizontal="3dp" />

        <TextView
            android:id="@+id/tvGop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="K:60"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <View android:layout_width="1dp" android:layout_height="10dp"
            android:background="#33FFFFFF" android:layout_marginHorizontal="3dp" />

        <TextView
            android:id="@+id/tvQueue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Q:5"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <View android:layout_width="1dp" android:layout_height="10dp"
            android:background="#33FFFFFF" android:layout_marginHorizontal="3dp" />

        <TextView
            android:id="@+id/tvCodec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="H.265"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <!-- ====== 中间：RTSP 地址 (弹性空间 + 可点击复制) ====== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:id="@+id/btnRtspUrlLayout">

            <TextView
                android:id="@+id/tvStreamUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="rtsp://..."
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:maxWidth="280dp"
                android:singleLine="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/tvTransport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UDP"
                android:textColor="#66FFFFFF"
                android:textSize="9sp"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/tvClientIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FF4444"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/tvWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#88FFFFFF"
                android:textSize="9sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- ====== 右侧：语言 / 预览 / 音频 / 闪光灯 / 翻转 / 网络 ====== -->
        <TextView
            android:id="@+id/tvLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="中"
            android:textColor="#88FFFFFF"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btnPreview"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_view"
            app:tint="#FFFFFF"
            android:contentDescription="Preview" />

        <ImageButton
            android:id="@+id/btnAudio"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_btn_speak_now"
            app:tint="#FFFFFF"
            android:contentDescription="Audio" />

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_flash_off"
            android:contentDescription="Flash" />

        <ImageButton
            android:id="@+id/btnFlip"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="#FFFFFF"
            android:contentDescription="Flip" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_network"
            android:contentDescription="Network" />

        <ImageButton
            android:id="@+id/btnPerfToggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_perf"
            android:contentDescription="Performance Monitor" />

        <ImageButton
            android:id="@+id/btnHelp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_help"
            android:contentDescription="Help" />
    </LinearLayout>

    <!-- Performance Monitor HUD Overlay -->
    <LinearLayout
        android:id="@+id/layoutPerfMonitor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#A6000000"
        android:padding="8dp"
        android:elevation="4dp"
        android:visibility="gone"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTopControls"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvPerfNetwork"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00FF00"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:text="NET: 0.00 MB/s" />

        <TextView
            android:id="@+id/tvPerfCpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#33B5E5"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:text="CPU: 0.0%"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvPerfMemory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFBB33"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:text="MEM: 0.0 MB"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvPerfAbrLoss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF8800"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:text="ABR: -- / Loss: --"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPerfFpsQueue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF00FF"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:text="FPS: -- / Buf: --"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPerfFrames"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF4444"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:text="Sent: -- / Drop: --"
            android:layout_marginTop="2dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 右侧：开始/停止按钮 -->
    <ImageButton
        android:id="@+id/fabAction"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/ic_shutter_pro"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 4. 底部专业控制区 -->
    <LinearLayout
        android:id="@+id/layoutBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:background="@color/mi_pro_bg_semi"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 刻度拨轮 -->
        <com.gld.rtsp_camera.RulerWheelView
            android:id="@+id/rulerWheel"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:visibility="gone" />

        <!-- 底部5等分按钮：变焦、曝光、对焦、白平衡、滤镜 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minHeight="56dp">

            <LinearLayout
                android:id="@+id/btnParamZoomLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvParamZoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/param_zoom"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tvZoomValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.0x"
                    android:textColor="@color/mi_pro_yellow"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnParamExpLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvParamExp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/param_ev"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tvExpValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/mi_pro_yellow"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnParamFocusLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvParamFocus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/param_focus"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tvFocusValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AF"
                    android:textColor="@color/mi_pro_yellow"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnWbLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvParamWb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/param_wb"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tvWbValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTO"
                    android:textColor="@color/mi_pro_yellow"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnFilterLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvParamFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/param_filter"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tvFilterValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="None"
                    android:textColor="@color/mi_pro_yellow"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


    <!-- 5. 客户端断开红色闪烁报警边框 -->
    <View
        android:id="@+id/viewAlertBorder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_alert_border"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
